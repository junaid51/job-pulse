# Copy to .env and fill in. Never committed — see .gitignore.

# Supabase, session pooler, IPv4. Same string the old host used.
DATABASE_URL=
# Shared with whatever wakes the poller.
POLL_TOKEN=
# The hostname the certificate is issued for, and the one the web app calls.
JOBPULSE_HOST=
# Where tapping a notification goes.
APP_URL=https://jobpulse-junaid.web.app
POLL_INTERVAL=5m

# Keyed providers. Leave blank to skip a provider. Careerjet also needs this
# machine's public IP registered on their side.
CAREERJET_API_KEY=
CAREERJET_SITE=
JOBSPIPE_API_KEY=
JOBVEN_API_KEY=
