[Unit]
Description=JobPulse API and poller
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=jobpulse
Group=jobpulse
WorkingDirectory=/opt/jobpulse
EnvironmentFile=/etc/jobpulse/env
ExecStart=/opt/jobpulse/jobpulse
# The whole point of leaving scale-to-zero hosting: the process stays up, so
# there is no cold start and the internal ticker can poll every five minutes.
Restart=always
RestartSec=5s

# It reads a config file and talks to a local database; nothing else is needed.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jobpulse

[Install]
WantedBy=multi-user.target
