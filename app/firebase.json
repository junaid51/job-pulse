{
  "flutter": {
    "platforms": {
      "ios": {
        "default": {
          "projectId": "jobpulse-junaid",
          "appId": "1:1079027519074:ios:80bed65145eb5cc5648b3b",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "jobpulse-junaid",
          "configurations": {
            "ios": "1:1079027519074:ios:80bed65145eb5cc5648b3b",
            "web": "1:1079027519074:web:fda43881298dad3a648b3b"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
