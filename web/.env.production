# The backend a production build talks to. Baked in at build time, so this file
# is the difference between a deployed app and one quietly calling localhost:
# a build without it falls back to http://localhost:8091 (see src/api.ts) and
# every screen sits on "the backend may be waking up" forever. It shipped that
# way once.
VITE_JOBPULSE_API=https://jobpulse-68gm.onrender.com
