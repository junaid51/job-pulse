# The backend a production build talks to. Baked in at build time, so this file
# is the difference between a deployed app and one quietly calling localhost:
# a build without it falls back to http://localhost:8091 (see src/api.ts) and
# every screen sits on "the backend may be waking up" forever. It shipped that
# way once.
VITE_JOBPULSE_API=https://jobpulse-68gm.onrender.com

# The web push key, pinned 2026-09-07. Public by design — it ships to every
# browser that opens the app — so it belongs in the repository rather than in
# somebody's shell history. Before this was set, a build fell back to Firebase's
# default web push certificate, which works but re-subscribes every device
# whenever the key it was subscribed under changes. Pinning it is what stops
# that churn on future deploys. From Firebase console -> Cloud Messaging ->
# Web Push certificates.
VITE_JOBPULSE_VAPID=BEtiYljkti75-vljI4tPJDdlgf-Wsptwhn4ZXZ6Mdv0WQWOnKFffdJWrdLhli5gsKaDX47Hcdp_cFS5ONxNX5rM
