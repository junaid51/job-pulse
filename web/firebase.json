{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }] }
    ]
  }
}
