# The Firebase service account key is the one real secret: it can SEND
# notifications. The client config (firebase_options.dart, the plist) is public
# identifiers and is committed — a fork points at its own project by re-running
# `flutterfire configure`.
*.serviceaccount.json
*firebase-adminsdk*.json
